<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAKA SERVICE CENTER | Washing & Cleaning</title>
  <meta name="description" content="KAKA SERVICE CENTER - Professional car and bike washing, foam wash, interior cleaning, polishing and pressure wash.">
  <link rel="stylesheet" href="style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<header class="header">
  <a class="brand" href="#home" aria-label="KAKA SERVICE CENTER home">
    <svg class="brand-logo" viewBox="0 0 170 70" role="img" aria-label="KAKA Service Center logo">
      <path d="M8 49 C25 43,31 23,55 20 C78 17,92 29,112 28 C128 27,139 18,158 18" fill="none" stroke="currentColor" stroke-width="3"/>
      <path d="M12 49 C34 57,57 56,79 53 C101 50,118 42,146 42" fill="none" stroke="currentColor" stroke-width="3"/>
      <path d="M34 44 L45 31 L70 30 L82 44" fill="none" stroke="currentColor" stroke-width="3"/>
      <circle cx="30" cy="49" r="6" fill="none" stroke="currentColor" stroke-width="3"/>
      <circle cx="91" cy="49" r="6" fill="none" stroke="currentColor" stroke-width="3"/>
      <text x="45" y="25" font-size="21" font-weight="800" font-family="Poppins, sans-serif" fill="currentColor">KAKA</text>
      <text x="45" y="40" font-size="8.5" font-weight="600" letter-spacing="1" font-family="Poppins, sans-serif" fill="currentColor">SERVICE CENTER</text>
      <circle cx="18" cy="20" r="3" fill="currentColor"/>
      <circle cx="26" cy="12" r="2.5" fill="currentColor"/>
      <circle cx="35" cy="7" r="2" fill="currentColor"/>
    </svg>
  </a>

  <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>

  <nav id="nav">
    <a class="active" href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">My Profile</a>
    <a href="#booking">Visit Form</a>
    <a href="#payment">Payment</a>
    <a href="#contact">Contact</a>
  </nav>

  <a class="header-btn" href="#booking">Book Now ↗</a>
</header>

<main>
<section id="home" class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">WELCOME TO</span>
      <h1>KAKA<br><span>SERVICE CENTER</span></h1>
      <p>Professional Washing & Cleaning Services for your Vehicle</p>
      <div class="hero-points">
        <span>🚗 Clean Vehicle</span>
        <span>💧 Fresh Look</span>
        <span>✓ Trusted Service</span>
      </div>
      <div class="hero-actions">
        <a class="primary-btn" href="#booking">Book a Service</a>
        <a class="outline-btn" href="#services">View Services</a>
      </div>
    </div>
    <div class="hero-badge">
      <div class="drop">💧</div>
      <strong>Clean Today</strong>
      <span>Shine Tomorrow</span>
    </div>
  </div>
</section>

<section id="services" class="section services">
  <div class="section-head">
    <span class="eyebrow">WHAT WE OFFER</span>
    <h2>Our Services</h2>
    <p>Complete cleaning solutions for your vehicle.</p>
  </div>
  <div class="service-grid">
    <article class="service-card"><div class="service-icon">🚗</div><h3>Car Washing</h3><p>Complete exterior vehicle washing and cleaning.</p><button data-service="Car Washing">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">🏍️</div><h3>Bike Washing</h3><p>Professional washing and cleaning for bikes.</p><button data-service="Bike Washing">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">💦</div><h3>Pressure Wash</h3><p>High-pressure cleaning for difficult dirt and mud.</p><button data-service="Pressure Wash">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">🫧</div><h3>Foam Wash</h3><p>Deep foam cleaning for a fresh and clean finish.</p><button data-service="Foam Wash">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">✨</div><h3>Polishing</h3><p>Polishing service to improve your vehicle's finish.</p><button data-service="Polishing">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">🧽</div><h3>Interior Cleaning</h3><p>Interior vacuuming and detailed cleaning service.</p><button data-service="Interior Cleaning">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">🪑</div><h3>Seat Cleaning</h3><p>Cleaning service for vehicle seats and upholstery.</p><button data-service="Seat Cleaning">Get Quote →</button></article>
    <article class="service-card"><div class="service-icon">🛞</div><h3>Tyre & Wheel Cleaning</h3><p>Tyre and wheel cleaning for a complete finish.</p><button data-service="Tyre & Wheel Cleaning">Get Quote →</button></article>
  </div>
</section>

<section id="about" class="profile-section">
  <div class="profile-logo-card">
    <div class="round-logo">
      <svg viewBox="0 0 170 70" aria-hidden="true">
        <path d="M8 49 C25 43,31 23,55 20 C78 17,92 29,112 28 C128 27,139 18,158 18" fill="none" stroke="currentColor" stroke-width="3"/>
        <path d="M12 49 C34 57,57 56,79 53 C101 50,118 42,146 42" fill="none" stroke="currentColor" stroke-width="3"/>
        <path d="M34 44 L45 31 L70 30 L82 44" fill="none" stroke="currentColor" stroke-width="3"/>
        <circle cx="30" cy="49" r="6" fill="none" stroke="currentColor" stroke-width="3"/>
        <circle cx="91" cy="49" r="6" fill="none" stroke="currentColor" stroke-width="3"/>
        <text x="45" y="25" font-size="21" font-weight="800" font-family="Poppins, sans-serif">KAKA</text>
        <text x="45" y="40" font-size="8.5" font-weight="600" letter-spacing="1" font-family="Poppins, sans-serif">SERVICE CENTER</text>
      </svg>
    </div>
    <div class="mini-stars">★★★★★</div>
    <p>WASHING • CLEANING • CARE</p>
  </div>

  <div class="profile-copy">
    <span class="eyebrow">ABOUT US</span>
    <h2>My Profile</h2>
    <p>Welcome to KAKA SERVICE CENTER. We provide professional vehicle washing and cleaning services with a focus on quality, proper cleaning and customer satisfaction.</p>
    <div class="checks">
      <span>✓ Professional Service</span><span>✓ Customer Friendly</span>
      <span>✓ Quality Cleaning</span><span>✓ Affordable Service</span>
    </div>
    <a class="primary-btn" href="#booking">Know More About Us →</a>
  </div>
</section>

<section id="booking" class="section booking">
  <div class="section-head left">
    <span class="eyebrow">BOOKING / VISIT FORM</span>
    <h2>Customer Visit / Booking Form</h2>
    <p>Fill the form and send your service request directly on WhatsApp.</p>
  </div>
  <div class="booking-layout">
    <form id="bookingForm" class="form-card">
      <div class="two-col">
        <label>Customer Name *
          <input id="name" required placeholder="Enter your name">
        </label>
        <label>Mobile Number *
          <input id="phone" required type="tel" pattern="[0-9]{10}" placeholder="10-digit mobile number">
        </label>
      </div>
      <div class="two-col">
        <label>Vehicle Type *
          <select id="vehicle" required><option value="">Select Vehicle</option><option>Car</option><option>Bike</option><option>SUV</option><option>Other</option></select>
        </label>
        <label>Select Service *
          <select id="service" required><option value="">Select Service</option><option>Car Washing</option><option>Bike Washing</option><option>Pressure Wash</option><option>Foam Wash</option><option>Polishing</option><option>Interior Cleaning</option><option>Seat Cleaning</option><option>Tyre & Wheel Cleaning</option></select>
        </label>
      </div>
      <div class="two-col">
        <label>Preferred Date *<input id="date" required type="date"></label>
        <label>Preferred Time
          <select id="time"><option value="">Select Time</option><option>9:00 AM - 11:00 AM</option><option>11:00 AM - 1:00 PM</option><option>2:00 PM - 4:00 PM</option><option>4:00 PM - 6:00 PM</option></select>
        </label>
      </div>
      <label>Message<textarea id="message" rows="4" placeholder="Write your requirement"></textarea></label>
      <button class="submit-btn" type="submit">🟢 Send Booking on WhatsApp</button>
      <small>By submitting, your request will open in WhatsApp for confirmation.</small>
    </form>

    <section id="payment" class="payment-section">
  <div class="payment-card">
    <div class="payment-copy">
      <span class="eyebrow">EASY PAYMENT</span>
      <h2>Make Payment</h2>
      <p>Pay conveniently through UPI.</p>

      <div class="upi-box">
        <span>UPI ID</span>
        <strong id="upiText">97249571@IBL</strong>
      </div>

      <a id="payNow"
         class="pay-btn"
         href="upi://pay?pa=97249571@IBL&pn=KAKA%20SERVICE%20CENTER&cu=INR">
        Pay Now ↗
      </a>

      <p class="payment-note">
        For desktop users, scan the QR code with your UPI app.
      </p>
    </div>

    <div class="qr-area">
      <div id="qr" class="qr">
        <img
          src="KAKA_SERVICE_CENTER_UPI_QR_97249571_IBL.png"
          alt="KAKA SERVICE CENTER UPI QR Code"
          style="width:220px;height:220px;"
        >
      </div>

      <strong>Scan & Pay</strong>
      <span>PhonePe • Google Pay • Paytm • BHIM</span>
    </div>
  </div>
</section>
<section id="payment" class="payment-section">
  <div class="payment-card">
    <div class="payment-copy">
      <span class="eyebrow">EASY PAYMENT</span>
      <h2>Make Payment</h2>
      <p>Pay conveniently through UPI. Replace the demo UPI ID below with your real business UPI ID.</p>
      <div class="upi-box"><span>UPI ID</span><strong id="upiText">kakaservicecenter@upi</strong></div>
      <a id="payNow" class="pay-btn" href="upi://pay?pa=kakaservicecenter@upi&pn=KAKA%20SERVICE%20CENTER&cu=INR">Pay Now ↗</a>
      <p class="payment-note">For desktop users, scan the QR code with your UPI app.</p>
    </div>
    <div class="qr-area">
      <div id="qr" class="qr"></div>
      <strong>Scan & Pay</strong>
      <span>PhonePe • Google Pay • Paytm • BHIM</span>
    </div>
  </div>
</section>

<section class="section why">
  <div class="section-head"><span class="eyebrow">WHY CHOOSE US</span><h2>Why KAKA SERVICE CENTER?</h2><p>Because your vehicle deserves the best care.</p></div>
  <div class="why-grid">
    <div><b>💎</b><h3>Quality Service</h3><p>We focus on proper cleaning and finishing.</p></div>
    <div><b>⏱️</b><h3>Quick Service</h3><p>We value your time and provide efficient service.</p></div>
    <div><b>💰</b><h3>Fair Pricing</h3><p>Transparent and reasonable service pricing.</p></div>
    <div><b>🛡️</b><h3>Trusted Service</h3><p>Customer satisfaction is our priority.</p></div>
  </div>
</section>

<section class="reviews">
  <div class="section-head"><span class="eyebrow">CUSTOMER REVIEWS</span><h2>What Our Customers Say</h2><p>Trusted by happy customers.</p></div>
  <div class="review-grid">
    <div class="review"><div class="avatar">RK</div><b>Rohit Sharma</b><div class="stars">★★★★★</div><p>“Excellent service! My car looks brand new. Highly recommended.”</p></div>
    <div class="review"><div class="avatar">NP</div><b>Neha Patel</b><div class="stars">★★★★★</div><p>“Very professional and quick service. Best washing center in town.”</p></div>
    <div class="review"><div class="avatar">AS</div><b>Amit Singh</b><div class="stars">★★★★★</div><p>“Affordable prices and great quality. I am a regular customer now.”</p></div>
  </div>
</section>

<section id="contact" class="contact-section">
  <div class="section-head left"><span class="eyebrow">GET IN TOUCH</span><h2>Contact KAKA SERVICE CENTER</h2></div>
  <div class="contact-grid">
    <div><span class="contact-icon">📞</span><h3>Call Us</h3><p>For booking and enquiry</p><a href="tel:+919724957169">+91 97249 57169</a></div>
    <div><span class="contact-icon">💬</span><h3>WhatsApp</h3><p>Send your service enquiry</p><a href="https://wa.me/919724957169" target="_blank">Chat on WhatsApp</a></div>
    <div><span class="contact-icon">📍</span><h3>Location</h3><p>KAKA SERVICE CENTER</p><a href="https://maps.google.com/" target="_blank">Open Google Maps</a></div>
  </div>
</section>
</main>

<footer>
  <div class="footer-brand">
    <div class="footer-k">KAKA</div>
    <span>SERVICE CENTER</span>
  </div>
  <p>Professional Washing • Cleaning • Care</p>
  <div class="footer-links"><a href="#home">Home</a><a href="#services">Services</a><a href="#about">Profile</a><a href="#booking">Booking</a><a href="#payment">Payment</a><a href="#contact">Contact</a></div>
  <p>© 2026 KAKA SERVICE CENTER. All Rights Reserved.</p>
</footer>

<a class="floating-wa" href="https://wa.me/919724957169" target="_blank">💬 Chat on WhatsApp</a>

